{
  "name": "@viamedici-spc/fp-ts-extensions",
  "version": "0.0.0",
  "description": "Extensions for fp-ts",
  "keywords": [
    "extensions",
    "fp-ts",
    "viamedici"
  ],
  "license": "MIT",
  "author": "Viamedici Software GmbH",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/viamedici-spc/fp-ts-extensions.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.js",
    "./Array": "./dist/Array.js",
    "./boolean": "./dist/boolean.js",
    "./Either": "./dist/Either.js",
    "./Eq": "./dist/Eq.js",
    "./function": "./dist/function.js",
    "./Identity": "./dist/Identity.js",
    "./Magma": "./dist/Magma.js",
    "./Map": "./dist/Map.js",
    "./Monoid": "./dist/Monoid.js",
    "./NonEmptyArray": "./dist/NonEmptyArray.js",
    "./number": "./dist/number.js",
    "./Option": "./dist/Option.js",
    "./Ord": "./dist/Ord.js",
    "./Predicate": "./dist/Predicate.js",
    "./ReadonlyArray": "./dist/ReadonlyArray.js",
    "./ReadonlyMap": "./dist/ReadonlyMap.js",
    "./ReadonlyNonEmptyArray": "./dist/ReadonlyNonEmptyArray.js",
    "./ReadonlyRecord": "./dist/ReadonlyRecord.js",
    "./ReadonlySet": "./dist/ReadonlySet.js",
    "./ReadonlyTuple": "./dist/ReadonlyTuple.js",
    "./Record": "./dist/Record.js",
    "./Set": "./dist/Set.js",
    "./string": "./dist/string.js",
    "./Task": "./dist/Task.js",
    "./TaskEither": "./dist/TaskEither.js",
    "./TaskOption": "./dist/TaskOption.js",
    "./TaskThese": "./dist/TaskThese.js",
    "./These": "./dist/These.js",
    "./Tuple": "./dist/Tuple.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "lint": "oxlint --deny-warnings",
    "test": "bun test",
    "verify": "bun check && bun check -p tests && bun run lint && bun fmt --check && bun run test && bun run build && bun run verify:package",
    "verify:package": "publint --strict && attw --pack . --profile esm-only --format table-flipped"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/bun": "^1.4.5",
    "oxlint": "^1.94.0",
    "publint": "^0.3.25",
    "tsdown": "^0.23.7"
  },
  "peerDependencies": {
    "fp-ts": "2.*"
  },
  "packageManager": "bun@1.4.5"
}
